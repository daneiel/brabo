POSTGRES_USER=brabo
POSTGRES_PASSWORD=brabo
POSTGRES_DB=brabo
DATABASE_URL=postgres://brabo:brabo@postgres:5432/brabo

# UID/GID que os containers de dev (api/web/engine) usam para rodar —
# NUNCA root — e que precisam bater com o dono do bind mount no host, senão
# tudo que o container escrever (apps/api/dist, o que o agente gerar num
# projeto em modo `mounted`) nasce com um dono que você não é. Descubra o
# seu com `id -u`/`id -g`; o default (1000) é o mais comum numa máquina
# Linux de desenvolvedor único, mas não é universal. NÃO use `${UID}` direto
# no compose no lugar disto: é somente-leitura no bash e não é exportado ao
# ambiente por padrão, então o Compose sempre veria vazio.
DEV_UID=1000
DEV_GID=1000

API_PORT=3000
ENGINE_PORT=4000
WEB_PORT=5173
# OLLAMA_PORT: porta do Ollama no HOST — mesmo default (11434) de uma
# instalação nativa de Ollama na máquina. scripts/dev/preflight.mjs detecta
# se já existe um Ollama de verdade escutando nela e, se sim, PERGUNTA uma
# vez qual instância usar, gravando a resposta em OLLAMA_MODE (host|
# container) e ajustando OLLAMA_PORT/OLLAMA_HOST sozinho — não defina
# OLLAMA_MODE à mão antes da primeira execução, é escrita AUTOMÁTICA do
# bootstrap, não uma opção para configurar de antemão. "Docker ›
# Reconfigurar Ollama" no menu do bootstrap.sh apaga as chaves gravadas e
# força a pergunta de novo. Ver OLLAMA_HOST mais abaixo.
OLLAMA_PORT=11434
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
WEB_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:3000
VITE_ENGINE_URL=http://localhost:4000

# Auth first-party (Fase 7a). AUTH_JWT_SECRET é a passphrase de onde o par
# Ed25519 que assina o access token é DERIVADO (scrypt) — nenhuma chave
# privada é commitada. Este valor vale SÓ em desenvolvimento: ele está
# publicado aqui, e por isso a api recusa subir com ele quando
# NODE_ENV=production (RN-114, mesmo padrão do ADR 0059). Em produção, gere o
# seu: openssl rand -base64 32
# AUTH_JWT_SECRET_PREVIOUS só é aceita na verificação, durante uma rotação:
# defina, espere os tokens antigos expirarem (15 min) e remova.
AUTH_JWT_SECRET=dev-auth-jwt-secret-change-me
# AUTH_JWT_SECRET_PREVIOUS=
# Rotacionar o pepper INVALIDA todo refresh e todo token de conta em aberto
# (logout global). Vazio = usa AUTH_JWT_SECRET. Ver o runbook.
# AUTH_TOKEN_PEPPER=
AUTH_REGISTRATION_ENABLED=true
# Tráfego interno engine <-> api: o MESMO segredo nos dois sentidos, comparado
# em tempo constante. Rotação: defina o _PREVIOUS com o valor antigo, atualize
# os dois serviços, e remova o _PREVIOUS depois. Ver docs/runbook.md. Mesma
# ressalva do AUTH_JWT_SECRET acima: o valor abaixo é público, e a api recusa
# subir com ele em produção (RN-114).
BRABO_SERVICE_TOKEN=dev-service-token-change-me
# BRABO_SERVICE_TOKEN_PREVIOUS=
# Teto do body parser JSON da api (Express). O Nest nunca configurou um
# limite explícito, então valia o default do Express (100 KB) — o gargalo
# mais estreito no sentido engine→api, que estourava `413` em
# `POST /internal/sessions/:sessionId/llm-turn` (o Phoenix aceita corpos de
# até 8 MB). Formato aceito pelo parser (ex.: "10mb", "500kb"); default
# "10mb" quando ausente, com folga sobre o teto do engine.
# API_JSON_BODY_LIMIT=10mb
# Lockout: escadas `falhas:segundos`, separadas por vírgula. A do e-mail tem
# teto igual à janela de propósito — ver docs/business-rules.md#rn-031.
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_THRESHOLDS=5:30,8:300,12:900
AUTH_LOCKOUT_IP_THRESHOLDS=20:30,30:120
# Só para desenvolvimento: expõe no log o token de verificação/reset, que o
# MailSender log-only não imprime por padrão.
# AUTH_MAIL_LOG_TOKENS=true

# SMTP real (backlog "SMTP real no MailSender", ADR 0096). MAIL_TRANSPORT
# vale "log" (default, inclusive em produção — enviar e-mail de verdade é
# OPT-IN do operador) ou "smtp". Só quando MAIL_TRANSPORT=smtp as cinco
# variáveis abaixo passam a ser exigidas e validadas no boot em produção
# (RN-114): ausente, só espaços ou com o valor de exemplo abaixo derruba o
# boot. SMTP_FROM é o endereço do remetente, formato "Nome <email@dominio>"
# (ou só o e-mail).
# MAIL_TRANSPORT=log
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Brabo <nao-responda@seu-dominio.com>

# Grafo de conhecimento (Neo4j) — memória DERIVADA do event log (templates de
# prompt versionados + memória relacional: interações, hipóteses do
# Psicólogo, perfis da Anamnese, handoffs). Ausente = grafo DESLIGADO (as
# rotas dependentes degradam para 503) — só em produção as três são
# obrigatórias e derrubam o boot se faltar alguma.
#
# NEO4J_URI é o INTERRUPTOR, e é a ÚNICA que precisa ser definida para ligar
# em dev: descomente a linha abaixo e recrie a api. Usuário e senha já chegam
# ao container com os mesmos defaults do NEO4J_AUTH do serviço `neo4j`, então
# defina os dois só para TROCAR a senha — e trocando aqui você troca dos dois
# lados de uma vez, servidor e cliente.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=dev-neo4j-password-change-me

# LLM: host do Ollama e chave mestra pra envelope encryption das
# credenciais do usuário (Anthropic/OpenAI). O valor abaixo é público neste
# repositório, e a api recusa subir com ele quando NODE_ENV=production
# (RN-114, mesmo padrão do ADR 0059). Em produção, gere o seu:
# openssl rand -base64 32
#
# OLLAMA_MODE=host (gravado automaticamente por scripts/dev/preflight.mjs,
# ver OLLAMA_PORT acima) troca este valor por
# http://host.docker.internal:<porta> — o Ollama nativo detectado, alcançado
# de dentro do container pelo `extra_hosts` do docker-compose.yml. Sem
# OLLAMA_MODE definido (o caso comum, sem Ollama nativo na máquina), o valor
# abaixo — o serviço `ollama` do próprio compose — é o que vale.
OLLAMA_HOST=http://ollama:11434
CREDENTIALS_MASTER_KEY=dev-master-key-change-me
# Teto de INATIVIDADE (silêncio no socket), não de duração total, dos
# providers de API. O Ollama tem o seu em OLLAMA_REQUEST_TIMEOUT_MS.
# LLM_REQUEST_TIMEOUT_MS=300000

# Modelos que o serviço `ollama-model-loader` do docker-compose puxa
# automaticamente no boot (lista separada por vírgula, sem espaço). Sem isto,
# `nomic-embed-text` — que o Chat RAG usa fixo para embedding — nunca é
# puxado sozinho, e a busca degrada em silêncio para léxico-only.
OLLAMA_REQUIRED_MODELS=gemma3:1b,yi-coder:1.5b,nomic-embed-text
# NEO4J_URI/NEO4J_USER/NEO4J_PASSWORD: ver o bloco "Grafo de conhecimento
# (Neo4j)" acima. O serviço `neo4j` do docker-compose SOBE mesmo com as três
# comentadas (o compose tem os próprios defaults de dev embutidos); só
# descomente aqui se quiser que a api/o engine conectem nele com uma senha
# diferente do default do compose.

# Git providers (Fase 2): OAuth Apps registrados no GitHub/GitLab.
# Authorization callback URL de cada um: ${API_PUBLIC_URL}/git/oauth/<provider>/callback
#
# ADR 0084 (login social) REUSA o MESMO app — mesmo client id/secret, sem
# variável nova. O que muda por fluxo é o `redirect_uri` e o `scope` pedido na
# autorização (login pede só perfil + e-mail; conexão de git pede repo/api).
# Cadastre TAMBÉM o segundo callback no provider:
# ${API_PUBLIC_URL}/auth/oauth/<provider>/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:3000
# Assina o `state` do OAuth, que é o que impede o callback de ser forjado.
# Este valor vale SÓ em desenvolvimento: ele está publicado aqui, e por isso a
# api recusa subir com ele quando NODE_ENV=production (ADR 0059). Em produção,
# gere a sua: openssl rand -base64 32
GIT_OAUTH_STATE_SECRET=dev-oauth-state-secret-change-me

# Motor de sessões: comando síncrono api -> engine (criar sessão
# supervisionada na ativação) e heartbeat de sessão (canal Phoenix).
#
# NÃO defina ENGINE_URL aqui. Este arquivo é o `--env-file` do `pnpm dev`, e o
# valor daqui SOBRESCREVE o `${ENGINE_URL:-http://engine:4000}` do compose:
# `localhost` dentro do container da api é a própria api, então toda ativação
# de sessão morria em ECONNREFUSED e o front ficava sem sair do lugar. Os dois
# ambientes já têm o default certo sem esta linha — o compose aponta para o
# serviço `engine`, e a api rodando no host cai no
# `?? 'http://localhost:4000'` de api-to-engine-client.ts. Só preencha para
# apontar para um engine que não é nenhum dos dois.
# ENGINE_URL=

# URL do engine alcançável PELO BROWSER — distinta de ENGINE_URL, que é uso
# INTERNO (api -> engine, dentro da rede do Compose). O runner local e a aba
# Terminal da web (ADR 0103/0104) rodam FORA do cluster, então precisam de um
# endereço que o navegador/CLI do usuário realmente alcance; `engineWsUrl`
# devolvido por `POST .../runner-ticket`/`.../terminal-ticket` vem desta
# variável (RN-419). O `docker/docker-compose.yml` já define um default são
# (`http://localhost:4000`, mesmo valor de `VITE_ENGINE_URL`) no serviço
# `api` — só preencha aqui se o engine público mora em outro endereço (ex.:
# atrás de um túnel/proxy).
# ENGINE_PUBLIC_URL=
SESSION_HEARTBEAT_TIMEOUT_MS=30000

# Pipeline de ações propostas (Fase 1 item 5): timeout do executor de
# terminal no engine. PROJECT_WORKSPACES_ROOT fica fixo em
# /data/project-workspaces DENTRO dos containers — o que pode mudar é de
# ONDE, no host, esse caminho vem (ver as duas variáveis abaixo).
TERMINAL_ACTION_TIMEOUT_MS=15000

# Por padrão, os workspaces dos projetos e os bare repos locais vivem em
# volumes Docker gerenciados (opacos — não são uma pasta que dá pra abrir no
# Finder/Explorer). Definir as duas variáveis abaixo troca isso por uma pasta
# REAL do seu disco: os arquivos que os agentes escrevem ficam visíveis e
# editáveis por fora do Docker, com o mesmo git/editor que você já usa.
#
# AVISO: a pasta escolhida vira a RAIZ de TODOS os projetos desta instância —
# cada projeto mora em <pasta>/<project_id>. Não aponte para $HOME inteiro
# nem para uma pasta com outros segredos seus; escolha uma pasta dedicada
# (ex.: ~/brabo-projetos).
#
# As DUAS variáveis têm que estar definidas (ou nenhuma) — api e engine
# leem o MESMO volume/pasta, e valores diferentes fariam os dois enxergarem
# árvores diferentes do mesmo repositório.
#
# Só testado em Linux/macOS. No Windows, bind mount de host no Docker
# Desktop tem armadilhas conhecidas (permissão/dono entre NTFS e o usuário do
# container, e NTFS não distingue maiúscula de minúscula onde o Linux
# distingue — pode confundir `git worktree`) — não habilite lá ainda.
# PROJECT_WORKSPACES_HOST_DIR=~/brabo-projetos
# GIT_LOCAL_REPOS_HOST_DIR=~/brabo-projetos-bare

# ---------------------------------------------------------------------------
# A base dos projetos no modo "Pasta montada" (ADR 0141)
# ---------------------------------------------------------------------------
#
# Esta é a ÚNICA pasta do seu computador que os containers do Brabo enxergam.
# Um projeto no modo "Pasta montada" mora DENTRO dela — e só dentro dela.
#
# Ela é montada por IDENTIDADE (`$X:$X`) nos serviços `api` e `engine`: o mesmo
# caminho no seu disco e dentro dos dois containers. Isso não é detalhe de
# implementação, é o que mantém honesto o caminho que você digita e que a tela
# mostra de volta — se o container montasse a pasta em outro lugar, a string
# gravada no projeto descreveria um caminho que não existe para ninguém.
#
# SEM ELA, o modo "Pasta montada" NÃO É OFERECIDO. A api reporta
# `projectsBase: null` e a criação de projeto simplesmente não mostra a opção —
# é deliberado: oferecer um modo que a instalação não honra produz um projeto
# que trava depois, na primeira ferramenta do primeiro agente, longe da tela
# onde a decisão foi tomada. Os modos `container` (o default) e `runner`
# continuam funcionando sem esta variável.
#
# O `~` NÃO É EXPANDIDO pelo Compose no lado que interessa aqui. Escreva o
# caminho ABSOLUTO, já expandido:
#
#   BRABO_PROJECTS_BASE=/home/voce/brabo        ✅
#   BRABO_PROJECTS_BASE=~/brabo                 ❌ vira uma pasta chamada "~"
#
# NÃO é a mesma coisa que PROJECT_WORKSPACES_HOST_DIR, acima, e conflá-las
# quebra de um jeito difícil de enxergar. Aquela é a raiz dos workspaces que o
# PRODUTO gerencia (modo `container`), nomeados por `workspace_dir_name`;
# esta é uma pasta SUA, com nomes que você escolhe. Apontar as duas para o
# mesmo lugar faria `<base>/loja` colidir com um projeto `container` cujo nome
# de pasta também fosse `loja` — e o bootstrap daria `git init` dentro do
# projeto do outro. Ver o ADR 0141 para os três motivos completos.
#
# Escolha uma pasta DEDICADA. Não aponte para o `$HOME` inteiro nem para uma
# pasta com outros segredos seus: tudo que estiver sob a base fica alcançável
# de dentro dos containers do produto. E NUNCA a aponte para (nem para dentro
# de) o checkout do próprio Brabo — `pnpm dev` recusa subir nesse caso, com a
# mensagem explicando por quê.
#
# Depois de definir (ou mudar): docker compose up -d api engine.
# BRABO_PROJECTS_BASE=/home/voce/brabo

# ---------------------------------------------------------------------------
# Broker de container (ADR 0130) — o ÚNICO processo do produto que fala com o
# daemon Docker do servidor, e o único serviço com /var/run/docker.sock
# montado.
#
# Ele NÃO sobe por padrão: está sob o profile `container-broker` nos dois
# composes. Dar acesso ao Docker do host a um processo que nada chama ainda
# seria mudar a postura de toda máquina de desenvolvimento em troca de nada.
# Para ligar:
#
#   docker compose -f docker/docker-compose.yml --env-file .env \
#     --profile container-broker up -d broker
#
# e descomentar as três linhas abaixo.
# ---------------------------------------------------------------------------

# Onde a api encontra o broker. VAZIA é o estado normal: sem ela, quem lê o
# estado observado de um container DIZ "não observado" em vez de herdar o
# estado registrado (RN-468). Só a api o alcança — a rede `broker` do compose é
# `internal: true` e o serviço não publica porta nenhuma.
# BROKER_URL=http://broker:8090

# O gid do grupo `docker` da SUA máquina. Descubra com:
#
#   getent group docker | cut -d: -f3
#
# O socket é `root:docker` no host e o processo do broker roda non-root; sem o
# gid certo toda operação morre com "permission denied" no socket. O default do
# compose (999) é o mais comum e está errado em várias distribuições.
# DOCKER_GID=999

# A raiz das pastas de projeto **NO HOST**. Não confunda com
# PROJECT_WORKSPACES_ROOT, que é o caminho DENTRO dos containers: o `-v` de um
# `docker run` é resolvido pelo DAEMON, que enxerga o filesystem do host, e um
# caminho de dentro da api faria o daemon criar e montar uma pasta VAZIA.
#
# Sem esta variável, `start` recusa dizendo exatamente isso — as outras quatro
# operações do broker continuam funcionando. Ela não tem como ser derivada de
# um volume Docker gerenciado: use PROJECT_WORKSPACES_HOST_DIR (acima) e repita
# aqui o mesmo caminho, JÁ EXPANDIDO (`~` não é expandido pelo Compose).
# PROJECT_WORKSPACES_HOST_ROOT=/home/voce/brabo-projetos

# A SEGUNDA raiz do broker: a base dos projetos MONTADOS, também no host
# (ADR 0141). Não precisa ser preenchida — ela DERIVA de BRABO_PROJECTS_BASE,
# que já é um caminho de host por definição (é ela que api e engine montam por
# identidade). Preencha só se, por alguma razão de topologia, o daemon Docker
# enxergar essa pasta por outro caminho.
#
# Nada a consome ainda: quem resolve um projeto `mounted` contra esta raiz é o
# PR que dá container ao modo "Pasta montada".
# BRABO_PROJECTS_HOST_BASE=/home/voce/brabo
