{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `test/` fica aqui, e não em `tsconfig.app.json`, porque são verificações de
  // NÍVEL DE ARQUIVO — leem `index.css`, `index.html` e `public/fonts/` do disco
  // (ADR 0036). Precisam dos tipos de `node`, e pôr `node` nos tipos da app
  // vazaria globais de Node para o código que roda no browser.
  "include": ["vite.config.ts", "test"]
}
