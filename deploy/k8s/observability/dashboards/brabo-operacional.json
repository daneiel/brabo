{
  "uid": "brabo-operacional",
  "title": "Brabo — visão operacional",
  "description": "Filas, latência de LLM, sessões e bloqueios. Painel de plantão.",
  "tags": [
    "brabo",
    "operacao"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Profundidade da fila do Oban por estado",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (oban_queue_depth)",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Backlog real (available) por fila",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (oban_queue_depth{state=\"available\"})",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latência de LLM p50 por provider",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(brabo_llm_call_duration_seconds_bucket[10m])))",
          "legendFormat": "p50 {{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Latência de LLM p95 por provider",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(brabo_llm_call_duration_seconds_bucket[10m])))",
          "legendFormat": "p95 {{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Sessões por estado",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(brabo_sessions_active) or vector(0)",
          "legendFormat": "ativas",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Tasks bloqueadas por projeto",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project) (brabo_tasks_blocked)",
          "legendFormat": "{{project}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Sessões hospedadas por réplica do engine",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "brabo_engine_sessions_hosted",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Erros de LLM por provider",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brabo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(brabo_llm_call_errors_total[10m])) * 600",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "brabo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
