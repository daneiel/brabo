# Fase de codificação: agentes de LLM desligados para não pesar a máquina.
# O sync de catálogo NÃO entra aqui — ele varre catálogo de provider, não
# gasta inferência, e sem ele nenhum modelo novo aparece para escolher.
# Reverter apagando a linha abaixo (e `docker compose ... start ollama`).
START_ANAMNESE=false
OLLAMA_MODE=host

# Grafo de conhecimento LIGADO (ADR 0099) — a URI é o interruptor; usuário e
# senha herdam o default do NEO4J_AUTH do serviço `neo4j` no compose.
NEO4J_URI=bolt://neo4j:7687

# gid do grupo `docker` DESTA máquina (getent group docker) — o default 999 do
# compose está errado aqui, e erra em silêncio: o broker sobe e só falha no
# `container_start`, com "permission denied" no socket.
DOCKER_GID=984
