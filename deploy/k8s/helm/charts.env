# Versões pinadas dos charts de terceiros instalados pelo bootstrap.
#
# Pinadas pelo mesmo motivo das versões nos Dockerfiles: um `helm install` sem
# `--version` instala o que estiver publicado no dia, e "funcionou ontem, não
# funciona hoje" vira um bug sem causa aparente. Atualizar é mudança
# deliberada, com commit próprio.
#
# Consumido por `deploy/k8s/bootstrap.sh` (shell puro, sem yq).

# External Secrets Operator — precisa ser versão que sirva a API v1
# (external-secrets.io/v1), que é a usada em base/common/externalsecrets.yaml.
ESO_CHART_VERSION=0.19.2
ESO_REPO=https://charts.external-secrets.io

# CloudNativePG: Postgres in-cluster para dev/staging.
CNPG_CHART_VERSION=0.23.2
CNPG_REPO=https://cloudnative-pg.github.io/charts

# Prometheus (só o server — ver prometheus-values.yaml).
PROMETHEUS_CHART_VERSION=27.28.1
PROMETHEUS_REPO=https://prometheus-community.github.io/helm-charts

# prometheus-adapter: serve a External Metrics API que o HPA do engine consome.
PROMETHEUS_ADAPTER_CHART_VERSION=5.1.0

# metrics-server: NÃO é opcional. Sem ele o HPA da api (por CPU) fica em
# `<unknown>`. k3d/k3s já traz; kind não.
METRICS_SERVER_CHART_VERSION=3.14.0
METRICS_SERVER_REPO=https://kubernetes-sigs.github.io/metrics-server/

# Imagem auxiliar do initContainer que renderiza o realm do Keycloak.
BUSYBOX_IMAGE=busybox:1.37.0

# --- Observabilidade (Fase 5, sessão 3) --------------------------------------
# Grafana: dashboards, datasources e alertas provisionados como código.
GRAFANA_CHART_VERSION=10.5.15
GRAFANA_REPO=https://grafana.github.io/helm-charts

# Tempo: backend de traces, recebe OTLP.
TEMPO_CHART_VERSION=1.24.4

# Loki: backend de logs. É ele que torna a correlação trace<->log clicável no
# Grafana (derivedFields no datasource), que foi a razão de incluí-lo.
LOKI_CHART_VERSION=7.1.0

# Alloy: coletor de logs dos pods (sucessor do promtail), DaemonSet.
ALLOY_CHART_VERSION=1.11.0

# OpenTelemetry Collector: recebe OTLP das apps e exporta para Tempo. Desacopla
# as apps do backend — trocar Tempo por outro é mudar o pipeline aqui, não a
# instrumentação de três serviços.
OTEL_COLLECTOR_CHART_VERSION=0.165.0
OTEL_COLLECTOR_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
