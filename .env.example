POSTGRES_USER=brabo
POSTGRES_PASSWORD=brabo
POSTGRES_DB=brabo
DATABASE_URL=postgres://brabo:brabo@postgres:5432/brabo


API_PORT=3000
ENGINE_PORT=4000
WEB_PORT=5173
OLLAMA_PORT=11434
WEB_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:3000
VITE_ENGINE_URL=http://localhost:4000

# Auth first-party (Fase 7a). AUTH_JWT_SECRET é a passphrase de onde o par
# Ed25519 que assina o access token é DERIVADO (scrypt) — nenhuma chave
# privada é commitada. Este valor vale SÓ em desenvolvimento: ele está
# publicado aqui, e por isso a api recusa subir com ele quando
# NODE_ENV=production (RN-114, mesmo padrão do ADR 0059). Em produção, gere o
# seu: openssl rand -base64 32
# AUTH_JWT_SECRET_PREVIOUS só é aceita na verificação, durante uma rotação:
# defina, espere os tokens antigos expirarem (15 min) e remova.
AUTH_JWT_SECRET=dev-auth-jwt-secret-change-me
# AUTH_JWT_SECRET_PREVIOUS=
# Rotacionar o pepper INVALIDA todo refresh e todo token de conta em aberto
# (logout global). Vazio = usa AUTH_JWT_SECRET. Ver o runbook.
# AUTH_TOKEN_PEPPER=
AUTH_REGISTRATION_ENABLED=true
# Tráfego interno engine <-> api: o MESMO segredo nos dois sentidos, comparado
# em tempo constante. Rotação: defina o _PREVIOUS com o valor antigo, atualize
# os dois serviços, e remova o _PREVIOUS depois. Ver docs/runbook.md. Mesma
# ressalva do AUTH_JWT_SECRET acima: o valor abaixo é público, e a api recusa
# subir com ele em produção (RN-114).
BRABO_SERVICE_TOKEN=dev-service-token-change-me
# BRABO_SERVICE_TOKEN_PREVIOUS=
# Lockout: escadas `falhas:segundos`, separadas por vírgula. A do e-mail tem
# teto igual à janela de propósito — ver docs/business-rules.md#rn-031.
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_THRESHOLDS=5:30,8:300,12:900
AUTH_LOCKOUT_IP_THRESHOLDS=20:30,30:120
# Só para desenvolvimento: expõe no log o token de verificação/reset, que o
# MailSender log-only não imprime por padrão.
# AUTH_MAIL_LOG_TOKENS=true

# SMTP real (backlog "SMTP real no MailSender", ADR 0096). MAIL_TRANSPORT
# vale "log" (default, inclusive em produção — enviar e-mail de verdade é
# OPT-IN do operador) ou "smtp". Só quando MAIL_TRANSPORT=smtp as cinco
# variáveis abaixo passam a ser exigidas e validadas no boot em produção
# (RN-114): ausente, só espaços ou com o valor de exemplo abaixo derruba o
# boot. SMTP_FROM é o endereço do remetente, formato "Nome <email@dominio>"
# (ou só o e-mail).
# MAIL_TRANSPORT=log
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Brabo <nao-responda@seu-dominio.com>

# LLM: host do Ollama e chave mestra pra envelope encryption das
# credenciais do usuário (Anthropic/OpenAI). O valor abaixo é público neste
# repositório, e a api recusa subir com ele quando NODE_ENV=production
# (RN-114, mesmo padrão do ADR 0059). Em produção, gere o seu:
# openssl rand -base64 32
OLLAMA_HOST=http://ollama:11434
CREDENTIALS_MASTER_KEY=dev-master-key-change-me
# Teto de INATIVIDADE (silêncio no socket), não de duração total, dos
# providers de API. O Ollama tem o seu em OLLAMA_REQUEST_TIMEOUT_MS.
# LLM_REQUEST_TIMEOUT_MS=300000

# Git providers (Fase 2): OAuth Apps registrados no GitHub/GitLab.
# Authorization callback URL de cada um: ${API_PUBLIC_URL}/git/oauth/<provider>/callback
#
# ADR 0084 (login social) REUSA o MESMO app — mesmo client id/secret, sem
# variável nova. O que muda por fluxo é o `redirect_uri` e o `scope` pedido na
# autorização (login pede só perfil + e-mail; conexão de git pede repo/api).
# Cadastre TAMBÉM o segundo callback no provider:
# ${API_PUBLIC_URL}/auth/oauth/<provider>/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:3000
# Assina o `state` do OAuth, que é o que impede o callback de ser forjado.
# Este valor vale SÓ em desenvolvimento: ele está publicado aqui, e por isso a
# api recusa subir com ele quando NODE_ENV=production (ADR 0059). Em produção,
# gere a sua: openssl rand -base64 32
GIT_OAUTH_STATE_SECRET=dev-oauth-state-secret-change-me

# Motor de sessões: comando síncrono api -> engine (criar sessão
# supervisionada na ativação) e heartbeat de sessão (canal Phoenix).
#
# NÃO defina ENGINE_URL aqui. Este arquivo é o `--env-file` do `pnpm dev`, e o
# valor daqui SOBRESCREVE o `${ENGINE_URL:-http://engine:4000}` do compose:
# `localhost` dentro do container da api é a própria api, então toda ativação
# de sessão morria em ECONNREFUSED e o front ficava sem sair do lugar. Os dois
# ambientes já têm o default certo sem esta linha — o compose aponta para o
# serviço `engine`, e a api rodando no host cai no
# `?? 'http://localhost:4000'` de api-to-engine-client.ts. Só preencha para
# apontar para um engine que não é nenhum dos dois.
# ENGINE_URL=
SESSION_HEARTBEAT_TIMEOUT_MS=30000

# Pipeline de ações propostas (Fase 1 item 5): timeout do executor de
# terminal no engine. PROJECT_WORKSPACES_ROOT fica fixo em
# /data/project-workspaces DENTRO dos containers — o que pode mudar é de
# ONDE, no host, esse caminho vem (ver as duas variáveis abaixo).
TERMINAL_ACTION_TIMEOUT_MS=15000

# Por padrão, os workspaces dos projetos e os bare repos locais vivem em
# volumes Docker gerenciados (opacos — não são uma pasta que dá pra abrir no
# Finder/Explorer). Definir as duas variáveis abaixo troca isso por uma pasta
# REAL do seu disco: os arquivos que os agentes escrevem ficam visíveis e
# editáveis por fora do Docker, com o mesmo git/editor que você já usa.
#
# AVISO: a pasta escolhida vira a RAIZ de TODOS os projetos desta instância —
# cada projeto mora em <pasta>/<project_id>. Não aponte para $HOME inteiro
# nem para uma pasta com outros segredos seus; escolha uma pasta dedicada
# (ex.: ~/brabo-projetos).
#
# As DUAS variáveis têm que estar definidas (ou nenhuma) — api e engine
# leem o MESMO volume/pasta, e valores diferentes fariam os dois enxergarem
# árvores diferentes do mesmo repositório.
#
# Só testado em Linux/macOS. No Windows, bind mount de host no Docker
# Desktop tem armadilhas conhecidas (permissão/dono entre NTFS e o usuário do
# container, e NTFS não distingue maiúscula de minúscula onde o Linux
# distingue — pode confundir `git worktree`) — não habilite lá ainda.
# PROJECT_WORKSPACES_HOST_DIR=~/brabo-projetos
# GIT_LOCAL_REPOS_HOST_DIR=~/brabo-projetos-bare
