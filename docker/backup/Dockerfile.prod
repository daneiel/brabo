# Imagem de BACKUP e RESTORE do Postgres (Fase 5, item 6).
#
# Quarta imagem do projeto, e a única que não serve tráfego: ela roda como
# CronJob (backup) e como Job pontual (teste de restore, ver
# deploy/k8s/test-restore.sh).
#
# Base `postgres:16-alpine` e não `alpine` + `postgresql-client`: o pg_dump tem
# que acompanhar a VERSÃO DO SERVIDOR. Um pg_dump 15 contra um servidor 16
# recusa a conexão com "server version mismatch", e um pg_dump mais novo gera
# dump que o pg_restore antigo não lê. Amarrar a base na mesma major que o
# docker-compose e o CloudNativePG usam tira essa classe de falha do caminho.
#
# Contexto de build: a raiz do repo (só para os scripts em docker/backup/).

FROM postgres:16-alpine AS runtime

# `mc`, o cliente do MinIO: binário estático único que fala qualquer endpoint
# S3-compatível, inclusive AWS S3. Escolhido sobre o awscli para não arrastar
# runtime Python inteiro para dentro de uma imagem que tem credencial de
# leitura do banco todo — menos superfície, e o download é um arquivo só.
#
# Versão PINADA com sha256 conferido: sem o pin, um rebuild pega a release do
# dia e o comportamento de `mc ls --json` (que a retenção parseia) pode mudar
# sem ninguém notar.
ARG MC_VERSION=RELEASE.2025-08-13T08-35-41Z
ARG MC_SHA256=01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891

# `pipefail` no RUN abaixo não é formalidade: o passo é
# `echo <sha> | sha256sum -c -`, e sem ele um erro do lado esquerdo do cano
# seria engolido — a verificação de integridade do binário passaria sem
# verificar nada, que é o pior resultado possível para este RUN.
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# `apk upgrade` antes do install pelo mesmo motivo da imagem da api: a tag da
# base é pinada (bom para reprodutibilidade) e isso congela também os patches
# de segurança do Alpine, que o trivy do CI acusaria.
# hadolint ignore=DL3018
RUN apk upgrade --no-cache \
 && apk add --no-cache curl jq \
 && curl -fsSL -o /usr/local/bin/mc \
      "https://dl.min.io/client/mc/release/linux-amd64/archive/mc.${MC_VERSION}" \
 && echo "${MC_SHA256}  /usr/local/bin/mc" | sha256sum -c - \
 && chmod +x /usr/local/bin/mc \
 && apk del curl

COPY --chmod=0755 docker/backup/backup.sh    /usr/local/bin/brabo-backup
COPY --chmod=0755 docker/backup/restore.sh   /usr/local/bin/brabo-restore

# O `mc` escreve config (o alias com a credencial) e o `pg_restore` escreve
# temporários. Os dois vão para /tmp, que no manifesto é um emptyDir — assim o
# rootfs do container pode subir read-only.
ENV MC_CONFIG_DIR=/tmp/mc \
    TMPDIR=/tmp

# uid 70 é o usuário `postgres` que a imagem oficial já cria. Non-root como as
# outras três imagens; não criamos usuário novo.
USER 70:70

# Sem CMD default de propósito: a mesma imagem é usada para duas coisas
# diferentes, e cada manifesto declara qual. Um default aqui só criaria a
# chance de o Job de restore rodar um backup por engano.
