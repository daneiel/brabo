POSTGRES_USER=brabo
POSTGRES_PASSWORD=brabo
POSTGRES_DB=brabo
DATABASE_URL=postgres://brabo:brabo@postgres:5432/brabo


API_PORT=3000
ENGINE_PORT=4000
WEB_PORT=5173
OLLAMA_PORT=11434
WEB_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:3000
VITE_ENGINE_URL=http://localhost:4000

# Auth first-party (Fase 7a). AUTH_JWT_SECRET é a passphrase de onde o par
# Ed25519 que assina o access token é DERIVADO (scrypt) — nenhuma chave
# privada é commitada. Em produção, troque por um segredo real.
# AUTH_JWT_SECRET_PREVIOUS só é aceita na verificação, durante uma rotação:
# defina, espere os tokens antigos expirarem (15 min) e remova.
AUTH_JWT_SECRET=dev-auth-jwt-secret-change-me
# AUTH_JWT_SECRET_PREVIOUS=
# Rotacionar o pepper INVALIDA todo refresh e todo token de conta em aberto
# (logout global). Vazio = usa AUTH_JWT_SECRET. Ver o runbook.
# AUTH_TOKEN_PEPPER=
AUTH_REGISTRATION_ENABLED=true
# Tráfego interno engine <-> api: o MESMO segredo nos dois sentidos, comparado
# em tempo constante. Rotação: defina o _PREVIOUS com o valor antigo, atualize
# os dois serviços, e remova o _PREVIOUS depois. Ver docs/runbook.md.
BRABO_SERVICE_TOKEN=dev-service-token-change-me
# BRABO_SERVICE_TOKEN_PREVIOUS=
# Lockout: escadas `falhas:segundos`, separadas por vírgula. A do e-mail tem
# teto igual à janela de propósito — ver docs/business-rules.md#rn-031.
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_THRESHOLDS=5:30,8:300,12:900
AUTH_LOCKOUT_IP_THRESHOLDS=20:30,30:120
# Só para desenvolvimento: expõe no log o token de verificação/reset, que o
# MailSender log-only não imprime por padrão.
# AUTH_MAIL_LOG_TOKENS=true

# LLM: host do Ollama e chave mestra pra envelope encryption das
# credenciais do usuário (Anthropic/OpenAI). Em produção, troque por um
# segredo real — nunca o valor de dev abaixo.
OLLAMA_HOST=http://ollama:11434
CREDENTIALS_MASTER_KEY=dev-master-key-change-me
# Teto de INATIVIDADE (silêncio no socket), não de duração total, dos
# providers de API. O Ollama tem o seu em OLLAMA_REQUEST_TIMEOUT_MS.
# LLM_REQUEST_TIMEOUT_MS=300000

# Git providers (Fase 2): OAuth Apps registrados no GitHub/GitLab.
# Authorization callback URL de cada um: ${API_PUBLIC_URL}/git/oauth/<provider>/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:3000
GIT_OAUTH_STATE_SECRET=dev-oauth-state-secret-change-me

# Motor de sessões: comando síncrono api -> engine (criar sessão
# supervisionada na ativação) e heartbeat de sessão (canal Phoenix).
ENGINE_URL=http://localhost:4000
SESSION_HEARTBEAT_TIMEOUT_MS=30000

# Pipeline de ações propostas (Fase 1 item 5): timeout do executor de
# terminal no engine. PROJECT_WORKSPACES_ROOT fica fixo em
# /data/project-workspaces dentro dos containers (mesmo volume Docker
# compartilhado entre api e engine) — não precisa mexer aqui pra dev.
TERMINAL_ACTION_TIMEOUT_MS=15000
